# ==============================================
# Aqua Fishing Academy ERP - Backend Environment
# Phase 2 - Sales CRM & Lead Management
# Copy this file to ".env" and fill in real values
# ==============================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/aqua_fishing_academy_erp

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_EXPIRES_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# Default Super Admin (used by seed script)
SUPER_ADMIN_NAME=System Administrator
SUPER_ADMIN_EMAIL=admin@aquafishingacademy.com
SUPER_ADMIN_PASSWORD=ChangeMe@12345

# Phase 2 - Sales CRM: base URL used to build generated payment links.
# Replace with your real payment gateway domain when one is integrated.
PAYMENT_LINK_BASE_URL=https://pay.aquafishingacademy.com/l

# ==============================================
# Phase 2.1 - Inbound Lead Webhooks
# (Meta/Facebook Lead Ads, Google Ads Lead Form, WhatsApp)
# All optional - each source stays off until its values are filled in.
# See INTEGRATIONS.md for the full setup guide.
# ==============================================

# Meta (Facebook + Instagram) Lead Ads
# 1) Any random string you invent - re-enter the SAME string as the
#    "Verify Token" in Meta App Dashboard > Webhooks.
META_VERIFY_TOKEN=choose_a_random_verify_token
# 2) Meta App Secret (App Dashboard > Settings > Basic) - used to verify
#    incoming webhook signatures. Recommended.
META_APP_SECRET=
# 3) Page Access Token with the leads_retrieval permission - used to fetch
#    lead field data (name/phone/email) after Meta pings the webhook.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v19.0

# Google Ads Lead Form extension - Webhook delivery method
# The secret key you set inside Google Ads when creating the webhook
# delivery - it is sent back on every payload as "google_key".
GOOGLE_ADS_WEBHOOK_KEY=

# WhatsApp Business Cloud API
# Usually lives under the same Meta App as above, so these fall back to
# META_VERIFY_TOKEN / META_APP_SECRET automatically if left blank.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
